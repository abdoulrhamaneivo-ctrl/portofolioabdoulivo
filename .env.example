# Required to protect /admin. Keep these values private.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-unique-password

# Optional: a separate signing secret for the admin session cookie.
ADMIN_SESSION_SECRET=choose-a-separate-random-secret

# Neon Postgres and Object Storage (configure in Vercel, never commit real values)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AWS_ENDPOINT_URL_S3=https://branch.storage.region.aws.neon.tech
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=neon-storage-credential-id
AWS_SECRET_ACCESS_KEY=neon-storage-secret
